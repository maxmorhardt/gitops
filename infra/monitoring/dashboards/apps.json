{
  "uid": "maxhq-apps",
  "title": "Apps",
  "description": "Health of the API services: traffic, errors, latency, database and outbox, plus squares activity.",
  "tags": [
    "maxhq"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "maxhq"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "Dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "regex": "/maxhqio-prom$/",
        "refresh": 1
      },
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "regex": "/maxhqio-logs$/",
        "refresh": 1
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(kube_node_info, cluster)",
          "refId": "cluster"
        },
        "definition": "label_values(kube_node_info, cluster)",
        "refresh": 2,
        "sort": 1,
        "current": {},
        "hide": 0,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(http_requests_total{cluster=\"$cluster\"}, job)",
          "refId": "service"
        },
        "definition": "label_values(http_requests_total{cluster=\"$cluster\"}, job)",
        "refresh": 2,
        "sort": 1,
        "current": {},
        "hide": 0,
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Services",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Services",
      "description": "Every API service over the dashboard's time range. Click a service to see it below.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job) (up{cluster=\"$cluster\"}) and on (job) group by (job) (http_requests_total{cluster=\"$cluster\"})",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job) (increase(http_requests_total{cluster=\"$cluster\", path!~\"/health.*|/swagger.*\", route!~\"/health.*|/swagger.*\"}[$__range])) or 0 * group by (job) (http_requests_total{cluster=\"$cluster\"})",
          "refId": "B",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (job) (increase(http_requests_total{cluster=\"$cluster\", path!~\"/health.*|/swagger.*\", route!~\"/health.*|/swagger.*\", status=~\"5..\"}[$__range])) or 0 * sum by (job) (increase(http_requests_total{cluster=\"$cluster\", path!~\"/health.*|/swagger.*\", route!~\"/health.*|/swagger.*\"}[$__range]))) / clamp_min(sum by (job) (increase(http_requests_total{cluster=\"$cluster\", path!~\"/health.*|/swagger.*\", route!~\"/health.*|/swagger.*\"}[$__range])), 1) or 0 * group by (job) (http_requests_total{cluster=\"$cluster\"})",
          "refId": "C",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (job) (increase(http_request_duration_seconds_sum{cluster=\"$cluster\", path!~\"/health.*|/swagger.*|/events/.*\", route!~\"/health.*|/swagger.*\"}[$__range])) / (sum by (job) (increase(http_request_duration_seconds_count{cluster=\"$cluster\", path!~\"/health.*|/swagger.*|/events/.*\", route!~\"/health.*|/swagger.*\"}[$__range])) > 0)",
          "refId": "D",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (job) (outbox_oldest_pending_seconds{cluster=\"$cluster\"})",
          "refId": "E",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "\u2013"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show ${__value.raw}",
                    "url": "/d/maxhq-apps?${__url_time_range}&${cluster:queryparam}&${datasource:queryparam}&${loki:queryparam}&var-service=${__value.raw}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Pods up"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.01
                    },
                    {
                      "color": "red",
                      "value": 0.05
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Avg latency"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.25
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Outbox lag"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 60
                    },
                    {
                      "color": "red",
                      "value": 300
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Requests",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "job",
                "Value #A",
                "Value #B",
                "Value #C",
                "Value #D",
                "Value #E"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "job": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5
            },
            "renameByName": {
              "job": "Service",
              "Value #A": "Pods up",
              "Value #B": "Requests",
              "Value #C": "5xx",
              "Value #D": "Avg latency",
              "Value #E": "Outbox lag"
            }
          }
        }
      ],
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 24,
        "h": 7
      }
    },
    {
      "type": "row",
      "title": "$service",
      "collapsed": false,
      "panels": [],
      "id": 3,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Requests",
      "description": "API requests over the dashboard's time range, not counting health checks.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(http_requests_total{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*\", route!~\"/health.*|/swagger.*\"}[$__range]))",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 4,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "5xx",
      "description": "Share of requests over the dashboard's time range that failed with a 5xx.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(increase(http_requests_total{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*\", route!~\"/health.*|/swagger.*\", status=~\"5..\"}[$__range])) or vector(0)) / clamp_min(sum(increase(http_requests_total{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*\", route!~\"/health.*|/swagger.*\"}[$__range])) or vector(0), 1)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 5,
      "gridPos": {
        "x": 6,
        "y": 9,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Avg latency",
      "description": "Mean response time over the dashboard's time range, not counting realtime's event streams.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by () (increase(http_request_duration_seconds_sum{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*|/events/.*\", route!~\"/health.*|/swagger.*\"}[$__range])) / (sum by () (increase(http_request_duration_seconds_count{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*|/events/.*\", route!~\"/health.*|/swagger.*\"}[$__range])) > 0)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": null,
          "noValue": "no traffic",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.25
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 6,
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Pods up",
      "description": "Pods Prometheus can scrape right now.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(up{cluster=\"$cluster\", job=\"$service\"}) or vector(0)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 7,
      "gridPos": {
        "x": 18,
        "y": 9,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Requests",
      "description": "Requests per interval by status class.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (class) (label_replace(increase(http_requests_total{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*\", route!~\"/health.*|/swagger.*\"}[$__interval]), \"class\", \"${1}xx\", \"status\", \"(.)..\"))",
          "refId": "A",
          "legendFormat": "{{class}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            }
          },
          "decimals": 0,
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "3xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "5m",
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Latency",
      "description": "Mean response time per endpoint. Gaps are stretches with no requests.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (method, path) (label_replace(rate(http_request_duration_seconds_sum{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*|/events/.*\", route!~\"/health.*|/swagger.*\"}[$__rate_interval]), \"path\", \"$1\", \"route\", \"(.+)\")) / (sum by (method, path) (label_replace(rate(http_request_duration_seconds_count{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*|/events/.*\", route!~\"/health.*|/swagger.*\"}[$__rate_interval]), \"path\", \"$1\", \"route\", \"(.+)\")) > 0)",
          "refId": "A",
          "legendFormat": "{{method}} {{path}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "drawStyle": "line",
            "stacking": {
              "mode": "none"
            }
          },
          "noValue": "no traffic"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Endpoints",
      "description": "Endpoints that served requests over the dashboard's time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (method, path) (label_replace(increase(http_requests_total{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*\", route!~\"/health.*|/swagger.*\"}[$__range]), \"path\", \"$1\", \"route\", \"(.+)\")) > 0)",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (method, path) (label_replace(increase(http_requests_total{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*\", route!~\"/health.*|/swagger.*\", status=~\"4..\"}[$__range]), \"path\", \"$1\", \"route\", \"(.+)\")) or 0 * (sum by (method, path) (label_replace(increase(http_requests_total{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*\", route!~\"/health.*|/swagger.*\"}[$__range]), \"path\", \"$1\", \"route\", \"(.+)\")) > 0)) and (sum by (method, path) (label_replace(increase(http_requests_total{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*\", route!~\"/health.*|/swagger.*\"}[$__range]), \"path\", \"$1\", \"route\", \"(.+)\")) > 0)",
          "refId": "B",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (method, path) (label_replace(increase(http_requests_total{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*\", route!~\"/health.*|/swagger.*\", status=~\"5..\"}[$__range]), \"path\", \"$1\", \"route\", \"(.+)\")) or 0 * (sum by (method, path) (label_replace(increase(http_requests_total{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*\", route!~\"/health.*|/swagger.*\"}[$__range]), \"path\", \"$1\", \"route\", \"(.+)\")) > 0)) and (sum by (method, path) (label_replace(increase(http_requests_total{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*\", route!~\"/health.*|/swagger.*\"}[$__range]), \"path\", \"$1\", \"route\", \"(.+)\")) > 0)",
          "refId": "C",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (method, path) (label_replace(increase(http_request_duration_seconds_sum{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*|/events/.*\", route!~\"/health.*|/swagger.*\"}[$__range]), \"path\", \"$1\", \"route\", \"(.+)\")) / (sum by (method, path) (label_replace(increase(http_request_duration_seconds_count{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*|/events/.*\", route!~\"/health.*|/swagger.*\"}[$__range]), \"path\", \"$1\", \"route\", \"(.+)\")) > 0) and (sum by (method, path) (label_replace(increase(http_requests_total{cluster=\"$cluster\", job=\"$service\", path!~\"/health.*|/swagger.*\", route!~\"/health.*|/swagger.*\"}[$__range]), \"path\", \"$1\", \"route\", \"(.+)\")) > 0)",
          "refId": "D",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
