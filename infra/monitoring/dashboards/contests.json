      {
        "name": "contest",
        "label": "Contest",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "${postgres}"
        },
        "query": "SELECT c.name || ' · ' || c.owner || ' · ' || to_char(c.created_at, 'Mon DD') AS __text, c.id::text AS __value\nFROM contests.contests c\nWHERE NOT c.owner ~* ('^(' || ${hide:sqlstring} || ')$')\nORDER BY (c.status = 'DELETED'), c.created_at DESC",
        "definition": "SELECT c.name || ' · ' || c.owner || ' · ' || to_char(c.created_at, 'Mon DD') AS __text, c.id::text AS __value\nFROM contests.contests c\nWHERE NOT c.owner ~* ('^(' || ${hide:sqlstring} || ')$')\nORDER BY (c.status = 'DELETED'), c.created_at DESC",
        "refresh": 1,
        "sort": 0,
        "current": {},
        "hide": 0,
