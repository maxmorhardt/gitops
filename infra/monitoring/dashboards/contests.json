    {
      "type": "table",
      "title": "Contests",
      "description": "Every contest the user filter matches as owner or player, with its game, kickoff, players, claimed squares, and bans. Click a contest to open it below, or an owner for their contests and requests.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "refId": "A",
          "rawSql": "SELECT\n  c.created_at AS \"Created\",\n  c.name AS \"Contest\",\n  c.owner AS \"Owner\",\n  u.display_name AS \"Owner name\",\n  c.status AS \"Status\",\n  c.visibility AS \"Visibility\",\n  coalesce(g.away_abbr || ' @ ' || g.home_abbr, c.away_team || ' @ ' || c.home_team) AS \"Game\",\n  g.game_time AS \"Kickoff\",\n  (SELECT count(*) FROM contests.contest_players p WHERE p.contest_id = c.id) AS \"Players\",\n  (SELECT count(*) FROM contests.squares s WHERE s.contest_id = c.id AND s.owner <> '') AS \"Squares\",\n  (SELECT count(*) FROM contests.contest_bans b WHERE b.contest_id = c.id) AS \"Bans\",\n  c.id::text AS id\nFROM contests.contests c\nLEFT JOIN contests.games g ON g.id = c.game_id\nLEFT JOIN accounts.users u ON u.email = c.owner\nWHERE (${status:sqlstring} = 'all' OR (c.status = 'DELETED') = (${status:sqlstring} = 'deleted'))\n  AND NOT c.owner ~* ('^(' || ${hide:sqlstring} || ')$')\n  AND (c.owner ~* ('^(' || ${user:sqlstring} || ')$') OR EXISTS (\n    SELECT 1 FROM contests.contest_players p WHERE p.contest_id = c.id AND p.user_id ~* ('^(' || ${user:sqlstring} || ')$')))\nORDER BY c.created_at DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Contest"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open ${__data.fields.Contest}",
                    "url": "/d/maxhq-contests/contests?var-contest=${__data.fields.id}&${user:queryparam}&${hide:queryparam}&${status:queryparam}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Owner"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Contests for ${__value.raw}",
                    "url": "/d/maxhq-contests/contests?var-user=${__value.raw:percentencode}&${hide:queryparam}&${status:queryparam}&${__url_time_range}"
                  },
                  {
                    "title": "Requests and location for ${__value.raw}",
                    "url": "/d/maxhq-users/users?var-user=${__value.raw:percentencode}&var-cluster=prod&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
