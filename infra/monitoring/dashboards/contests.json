    {
      "type": "table",
      "title": "Timeline",
      "description": "What users did, newest first, rebuilt from what the database holds now: a square claimed and later cleared, an unban, an invite link reset, or a contest edit doesn't show. The Users dashboard's request logs have those for 14 days.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "refId": "A",
          "rawSql": "SELECT e.time AS \"Time\", e.user AS \"User\", e.action AS \"Action\", e.contest AS \"Contest\", e.contest_id AS id\nFROM (\n  SELECT u.created_at AS time, u.email AS user, 'signed up' AS action, '' AS contest, '' AS contest_id, '' AS owner\n  FROM accounts.users u\n  UNION ALL\n  SELECT c.created_at, c.owner, 'created contest (' || c.visibility || ')', c.name, c.id::text, c.owner\n  FROM contests.contests c\n  UNION ALL\n  SELECT c.updated_at, coalesce(c.updated_by, c.owner), 'deleted contest', c.name, c.id::text, c.owner\n  FROM contests.contests c WHERE c.status = 'DELETED'\n  UNION ALL\n  SELECT p.joined_at, p.user_id, 'joined as ' || p.role, c.name, c.id::text, c.owner\n  FROM contests.contest_players p JOIN contests.contests c ON c.id = p.contest_id\n  WHERE p.role <> 'owner'\n  UNION ALL\n  SELECT s.claimed_at, s.owner, 'claimed square ' || s.row || ',' || s.col, c.name, c.id::text, c.owner\n  FROM contests.squares s JOIN contests.contests c ON c.id = s.contest_id\n  WHERE s.owner <> ''\n  UNION ALL\n  SELECT b.created_at, b.user_id, 'banned', c.name, c.id::text, c.owner\n  FROM contests.contest_bans b JOIN contests.contests c ON c.id = b.contest_id\n) e\nWHERE $__timeFilter(e.time) AND e.user ~* ('^(' || ${user:sqlstring} || ')$') AND NOT e.user ~* ('^(' || ${hide:sqlstring} || ')$') AND NOT e.owner ~* ('^(' || ${hide:sqlstring} || ')$')\nORDER BY e.time DESC\nLIMIT 500",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "id"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
