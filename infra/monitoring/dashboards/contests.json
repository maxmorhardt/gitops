    {
      "type": "table",
      "title": "Users",
      "description": "Every account the user filter matches, most recently active first. Last activity is the newest sign-up, contest, join, or square.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${postgres}"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${postgres}"
          },
          "refId": "A",
          "rawSql": "SELECT\n  u.created_at AS \"Signed up\",\n  u.email AS \"User\",\n  u.display_name AS \"Name\",\n  (SELECT count(*) FROM contests.contests c WHERE c.owner = u.email AND c.status <> 'DELETED') AS \"Contests owned\",\n  (SELECT count(*) FROM contests.contest_players p JOIN contests.contests c ON c.id = p.contest_id\n    WHERE p.user_id = u.email AND p.role <> 'owner' AND c.status <> 'DELETED' AND NOT c.owner ~* ('^(' || ${hide:sqlstring} || ')$')) AS \"Contests joined\",\n  (SELECT count(*) FROM contests.squares s JOIN contests.contests c ON c.id = s.contest_id\n    WHERE s.owner = u.email AND c.status <> 'DELETED' AND NOT c.owner ~* ('^(' || ${hide:sqlstring} || ')$')) AS \"Squares\",\n  greatest(\n    u.created_at,\n    (SELECT max(c.created_at) FROM contests.contests c WHERE c.owner = u.email),\n    (SELECT max(p.joined_at) FROM contests.contest_players p WHERE p.user_id = u.email),\n    (SELECT max(s.claimed_at) FROM contests.squares s WHERE s.owner = u.email)\n  ) AS \"Last activity\"\nFROM accounts.users u\nWHERE u.email ~* ('^(' || ${user:sqlstring} || ')$') AND NOT u.email ~* ('^(' || ${hide:sqlstring} || ')$')\nORDER BY \"Last activity\" DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
