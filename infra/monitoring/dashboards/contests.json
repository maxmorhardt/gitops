                "value": [
                  {
                    "title": "Contests for ${__value.raw}",
                    "url": "/d/maxhq-contests/contests?var-user=${__value.raw:percentencode}&${hide:queryparam}&${status:queryparam}&${__url_time_range}"
                  },
                  {
                    "title": "Requests and location for ${__value.raw}",
                    "url": "/d/maxhq-users/users?var-user=${__value.raw:percentencode}&var-cluster=prod&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
