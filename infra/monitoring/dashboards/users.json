      "transformations": [
        {
          "id": "fieldLookup",
          "options": {
            "lookupField": "cf_country",
            "gazetteer": "public/gazetteer/countries.json"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "id": true,
              "lat": true,
              "lng": true
            },
            "indexByName": {
              "name": 0,
              "cf_country": 1,
              "Value #A": 2
            },
            "renameByName": {
              "name": "Country",
              "cf_country": "Code",
              "Value #A": "Users"
            }
          }
