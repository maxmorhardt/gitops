{
  "uid": "maxhq-users",
  "title": "Users",
  "description": "Who uses the apps and from where: active users, logins, countries, regions, and ad sessions, from API request logs, Dex login logs, and Faro events.",
  "tags": [
    "maxhq"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "maxhq"
      ],
      "asDropdown": false,
      "includeVars": true,
      "keepTime": true,
      "title": "Dashboards"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "regex": "/maxhqio-prom$/",
        "refresh": 1
      },
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0,
        "regex": "/maxhqio-logs$/",
        "refresh": 1
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(kube_node_info, cluster)",
          "refId": "cluster"
        },
        "definition": "label_values(kube_node_info, cluster)",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "prod",
          "value": "prod"
        },
        "hide": 0,
        "multi": false,
        "includeAll": false
      },
      {
        "name": "app",
        "label": "App",
        "type": "custom",
        "query": "squares,olympics",
        "multi": true,
        "includeAll": true,
        "allValue": "squares|olympics",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "squares",
            "value": "squares"
          },
          {
            "selected": false,
            "text": "olympics",
            "value": "olympics"
          }
        ],
        "hide": 0
      },
      {
        "name": "user",
        "label": "User (regex)",
        "type": "textbox",
        "query": ".+",
        "current": {
          "text": ".+",
          "value": ".+"
        },
        "options": [
          {
            "selected": true,
            "text": ".+",
            "value": ".+"
          }
        ],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Active users",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "stat",
      "title": "Active users, 24h",
      "description": "Signed-in users who made at least one API request in the last 24 hours.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "count(sum by (user) (count_over_time({cluster=\"$cluster\", namespace=~\"$app\"} |= \"\\\"msg\\\":\\\"request\\\"\" | json user=\"user\", cf_country=\"cf_country\" | user=~\"$user\" [24h])))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Active users, 7d",
      "description": "Signed-in users who made at least one API request in the last 7 days.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "count(sum by (user) (count_over_time({cluster=\"$cluster\", namespace=~\"$app\"} |= \"\\\"msg\\\":\\\"request\\\"\" | json user=\"user\", cf_country=\"cf_country\" | user=~\"$user\" [7d])))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Logins, 24h",
      "description": "Successful Dex logins in the last 24 hours, across every app that signs in through Dex.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum(count_over_time({cluster=\"$cluster\", namespace=\"dex\"} |= \"login successful\" | logfmt [24h]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Countries, 24h",
      "description": "Countries signed-in users made requests from in the last 24 hours, from Cloudflare's CF-IPCountry header.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "count(sum by (cf_country) (count_over_time({cluster=\"$cluster\", namespace=~\"$app\"} |= \"\\\"msg\\\":\\\"request\\\"\" | json user=\"user\", cf_country=\"cf_country\" | user=~\"$user\" | cf_country!=\"\" [24h])))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
      },
      "id": 5,
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "barchart",
      "title": "Daily active users",
      "description": "Signed-in users with at least one API request each UTC day, by app. Logs are kept 14 days.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "count by (day, namespace) (sum by (day, namespace, user) (count_over_time({cluster=\"$cluster\", namespace=~\"$app\"} |= \"\\\"msg\\\":\\\"request\\\"\" | json user=\"user\", cf_country=\"cf_country\" | user=~\"$user\" | label_format day=`{{ __timestamp__ | date \"2006-01-02\" }}` [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "day\\namespace",
        "stacking": "normal",
        "orientation": "vertical",
        "showValue": "never",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "namespace",
            "rowField": "day",
            "valueField": "Value #A",
            "emptyValue": "zero"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "day\\namespace"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "day\\namespace": ""
            }
          }
        }
      ],
      "timeFrom": "14d",
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "barchart",
      "title": "Hourly active users",
      "description": "Signed-in users with at least one API request each UTC hour, by app.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "count by (hour, namespace) (sum by (hour, namespace, user) (count_over_time({cluster=\"$cluster\", namespace=~\"$app\"} |= \"\\\"msg\\\":\\\"request\\\"\" | json user=\"user\", cf_country=\"cf_country\" | user=~\"$user\" | label_format hour=`{{ __timestamp__ | date \"01-02 15:00\" }}` [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "hour\\namespace",
        "stacking": "normal",
        "orientation": "vertical",
        "showValue": "never",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "namespace",
            "rowField": "hour",
            "valueField": "Value #A",
            "emptyValue": "zero"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "hour\\namespace"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "hour\\namespace": ""
            }
          }
        }
      ],
      "timeFrom": "2d",
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Who",
      "collapsed": false,
      "panels": [],
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Users",
      "description": "API requests per signed-in user, app, location, and IP over the dashboard's time range. Region and city are blank before Cloudflare's visitor location headers were turned on.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (user, namespace, cf_country, cf_region, cf_city, client_ip) (count_over_time({cluster=\"$cluster\", namespace=~\"$app\"} |= \"\\\"msg\\\":\\\"request\\\"\" | json user=\"user\", cf_country=\"cf_country\", cf_region=\"cf_region\", cf_city=\"cf_city\", client_ip=\"client_ip\" | user=~\"$user\" [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "User"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Contests for ${__value.raw}",
                    "url": "/d/maxhq-contests/contests?var-user=${__value.raw:percentencode}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Requests",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "user": 0,
              "namespace": 1,
              "cf_country": 2,
              "cf_region": 3,
              "cf_city": 4,
              "client_ip": 5,
              "Value #A": 6
            },
            "renameByName": {
              "user": "User",
              "namespace": "App",
              "cf_country": "Country",
              "cf_region": "Region",
              "cf_city": "City",
              "client_ip": "IP",
              "Value #A": "Requests"
            }
          }
        }
      ],
      "id": 9,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "barchart",
      "title": "Logins per day",
      "description": "Successful Dex logins each UTC day, by provider.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (day, connector_id) (count_over_time({cluster=\"$cluster\", namespace=\"dex\"} |= \"login successful\" | logfmt | label_format day=`{{ __timestamp__ | date \"2006-01-02\" }}` [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "day\\connector_id",
        "stacking": "normal",
        "orientation": "vertical",
        "showValue": "never",
        "barWidth": 0.8,
        "groupWidth": 0.7,
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "connector_id",
            "rowField": "day",
            "valueField": "Value #A",
            "emptyValue": "zero"
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "day\\connector_id"
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "day\\connector_id": ""
            }
          }
        }
      ],
      "timeFrom": "14d",
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Logins",
      "description": "Successful Dex logins per user, provider, and client over the dashboard's time range.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "sum by (email, connector_id, client_id) (count_over_time({cluster=\"$cluster\", namespace=\"dex\"} |= \"login successful\" | logfmt [$__range]))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Logins",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "email": 0,
              "connector_id": 1,
              "client_id": 2,
              "Value #A": 3
            },
            "renameByName": {
              "email": "Email",
              "connector_id": "Provider",
              "client_id": "Client",
              "Value #A": "Logins"
            }
          }
        }
      ],
      "id": 10,
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "Recent logins",
      "description": "Successful Dex logins, newest first.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{cluster=\"$cluster\", namespace=\"dex\"} |= \"login successful\" | logfmt | line_format \"{{.email}}  via {{.connector_id}}  into {{.client_id}}\"",
          "refId": "A",
          "queryType": "range",
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "id": 12,
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "Recent requests",
      "description": "Signed-in API requests, newest first.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "{cluster=\"$cluster\", namespace=~\"$app\"} |= \"\\\"msg\\\":\\\"request\\\"\" | json user=\"user\", cf_country=\"cf_country\", cf_region=\"cf_region\", cf_city=\"cf_city\", client_ip=\"client_ip\", method=\"method\", route=\"route\", status=\"status\", service=\"service\" | user=~\"$user\" | line_format \"{{.user}}  {{.cf_city}}, {{.cf_region}}, {{.cf_country}}  {{.client_ip}}  {{ or .service .namespace }}  {{.method}} {{.route}}  {{.status}}\"",
          "refId": "A",
          "queryType": "range",
          "legendFormat": ""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "dedupStrategy": "none"
      },
      "id": 13,
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 10
      }
    },
    {
      "type": "row",
      "title": "Where",
      "collapsed": false,
      "panels": [],
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 50,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "geomap",
      "title": "Users by country",
      "description": "Signed-in users per country over the dashboard's time range.",
      "datasource": {
        "type": "loki",
        "uid": "${loki}"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${loki}"
          },
          "expr": "count by (cf_country) (sum by (cf_country, user) (count_over_time({cluster=\"$cluster\", namespace=~\"$app\"} |= \"\\\"msg\\\":\\\"request\\\"\" | json user=\"user\", cf_country=\"cf_country\" | user=~\"$user\" | cf_country!=\"\" [$__range])))",
          "refId": "A",
          "queryType": "instant",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "Users"
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "zero",
